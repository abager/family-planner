# Kopiér til .env (og hold den hemmelig). Docker Compose læser den.

# Familiens fælles adgangskode til appen – mindst 8 tegn. Skift den, og alle bliver logget ud.
FAMILIEPLAN_PASSWORD=skift-mig-til-noget-langt

# Ekstra kode til private samtaler med skolen – mindst 4 tegn, helst en anden end adgangskoden.
# Uden den kan private samtaler ikke åbnes i appen (de står kun som "Privat samtale").
FAMILIEPLAN_PRIVATE_CODE=skift-mig-ogsaa

# Hvem må nå serveren? 127.0.0.1 = kun denne maskine (brug med Caddy/Tailscale foran).
# 0.0.0.0 = alle på netværket (hjemmenetværk). Aldrig 0.0.0.0 på en server på internettet uden HTTPS.
BIND=127.0.0.1

# Kun til HTTPS med Caddy:
# FAMILIEPLAN_DOMAIN=familieplan.eksempel.dk

# Sprogmodellen til overblikket ([ai] i config.toml). Google AI Studio → "Get API key".
# Skriv nøglen direkte efter = – INGEN mellemrum og INGEN anførselstegn.
# Projektets fakturering (billing) skal forblive slået FRA, så gratis-niveauet aldrig kan koste penge.
GEMINI_API_KEY=

# Kun hvis du skifter til [ai] provider = "claude":
# ANTHROPIC_API_KEY=
